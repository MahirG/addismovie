# Create a TMDB account, then copy your API Read Access Token here.
# Keep this token server-side. Do not expose it with NEXT_PUBLIC_.
TMDB_READ_TOKEN=your_tmdb_api_read_access_token

# Default provider region used on detail pages.
TMDB_REGION=ET

# Optional: enables individual Ethiopian movie cards from whitelisted official
# YouTube publishers. The playlist player works even without this key.
YOUTUBE_API_KEY=your_youtube_data_api_v3_key
